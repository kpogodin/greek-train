generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Word {
  id                    Int        @id @default(autoincrement())
  translationRu         String
  pronunciation         String?
  category              String?
  difficulty            Int        @default(3)
  exampleGreek          String?
  examplePronunciation  String?
  exampleTranslationRu  String?
  forms                 WordForm[]
  createdAt             DateTime   @default(now())
}

model WordForm {
  id     Int    @id @default(autoincrement())
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)
  wordId Int
  form   String

  @@index([wordId])
}

model ConjugationSentence {
  id            Int      @id @default(autoincrement())
  group         Int      @default(1)
  before        String
  after         String
  correctAnswer String
  verbLemma     String
  translationRu String
  pronunciation String   @default("")
  createdAt     DateTime @default(now())

  @@index([group])
}

model WordProgress {
  id          Int      @id @default(autoincrement())
  learnerName String
  wordId      Int
  learned     Boolean  @default(false)
  timesSeen   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([learnerName, wordId])
  @@index([learnerName])
}

model ConjugationProgress {
  id           Int      @id @default(autoincrement())
  learnerName  String
  sentenceId   Int
  timesCorrect Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([learnerName, sentenceId])
  @@index([learnerName])
}

model SmallTalkPrompt {
  id        Int                @id @default(autoincrement())
  promptRu  String
  variants  SmallTalkVariant[]
  createdAt DateTime           @default(now())
}

model SmallTalkVariant {
  id            Int             @id @default(autoincrement())
  prompt        SmallTalkPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  promptId      Int
  order         Int             @default(0)
  speaker       String          @default("them")
  phraseGreek   String
  translationRu String
  pronunciation String

  @@index([promptId])
}

model SmallTalkProgress {
  id          Int      @id @default(autoincrement())
  learnerName String
  promptId    Int
  timesKnown  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([learnerName, promptId])
  @@index([learnerName])
}
